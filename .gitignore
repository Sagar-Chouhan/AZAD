# ==========================================
# Azad Foundation Monorepo - Git Ignore
# ==========================================

# Git backup folders
.git_backup/
**/.git_backup/

# Sensitive environment files & credentials
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
!**/.env.example

# Python virtual environments & bytecode
.venv/
venv/
env/
ENV/
**/.venv/
**/venv/
**/env/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node.js & Frontend dependencies/builds
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
out/
.next/
.nuxt/

# Media, Large Uploads & Video Files (>100MB violates GitHub limits)
uploads/
**/uploads/
storage/
**/storage/
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.flv
*.webm
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.apk
*.ipa

# Logs & temporary runtime files
*.log
logs/
**/logs/
*.sqlite3
*.db

# Large Database Dumps
/MIS-LMS-DB.sql
**/azadlms_dev_db.sql
*.sql.gz

# IDE and Editor files
.idea/
**/.idea/
.vscode/
**/.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.claude/
**/.claude/
scratch/
**/scratch/
